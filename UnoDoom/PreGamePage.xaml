<Page x:Class="UnoDoom.PreGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:UnoDoom"
      Background="Black">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,40">
            <Image Source="ms-appx:///Assets/unodoomicon.png"
                   Width="120"
                   Height="120"
                   Margin="0,0,0,20"/>
            <TextBlock Text="UnoDoom"
                       FontSize="36"
                       Foreground="White"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Select a WAD file to play"
                       FontSize="18"
                       Foreground="#808080"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- WAD List -->
        <ListView x:Name="WadListView"
                  Grid.Row="1"
                  SelectionMode="Single"
                  SelectionChanged="WadListView_SelectionChanged"
                  Background="Transparent"
                  MaxWidth="600">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,4"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="15,12"
                          Background="#20FFFFFF"
                          CornerRadius="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}"
                                       FontSize="18"
                                       Foreground="White"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding FileSizeText}"
                                       FontSize="12"
                                       Foreground="#808080"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="Bundled"
                                   FontSize="12"
                                   Foreground="#60FFFF00"
                                   VerticalAlignment="Center"
                                   Margin="12,0"
                                   Visibility="{Binding IsBundled, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <Button Grid.Column="2"
                                x:Name="DeleteButton"
                                Content="&#xE74D;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Background="#40FF0000"
                                Foreground="White"
                                Padding="12,8"
                                CornerRadius="4"
                                Click="DeleteButton_Click"
                                Visibility="{Binding IsBundled, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="20"
                    Margin="0,20,0,20">
            <Button x:Name="AddWadButton"
                    Content="Add WAD File"
                    Click="AddWadButton_Click"
                    Padding="30,15"
                    FontSize="16"
                    Background="#404040"
                    Foreground="White"
                    CornerRadius="8"/>
            <Button x:Name="StartGameButton"
                    Content="Start Game"
                    Click="StartGameButton_Click"
                    Padding="30,15"
                    FontSize="16"
                    Background="#008800"
                    Foreground="White"
                    CornerRadius="8"
                    IsEnabled="False"/>
        </StackPanel>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="3"
              Background="#C0000000"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressRing IsActive="True"
                              Width="60"
                              Height="60"/>
                <TextBlock x:Name="LoadingText"
                           Text="Loading..."
                           Foreground="White"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Page.Resources>
</Page>
